# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production         # development | production
PORT=4001

# ─── Storage driver ─────────────────────────────────────────────────────────
# "fs"  → flat-file JSON database (zero deps, good for dev/local)
# "pg"  → PostgreSQL with PostGIS (recommended for production)
STORAGE_DRIVER=fs

# ─── FS storage (used when STORAGE_DRIVER=fs) ───────────────────────────────
DATA_DIR=./data
FS_DB_FILE_NAME=forms-db.json

# ─── PostgreSQL (used when STORAGE_DRIVER=pg) ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/?options=-c%20search_path=forms3dkartan,public
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=10000

# disable | require | no-verify
PG_SSL_MODE=disable

# ─── Admin UI session auth ───────────────────────────────────────────────────
ADMIN_BASIC_AUTH_USER=admin
# Generate with: node scripts/hash-admin-password.js mySecretPassword
ADMIN_BASIC_AUTH_PASS_HASH=$2b$12$examplehashchangeme

# ─── CORS ───────────────────────────────────────────────────────────────────
# Allow this origin to call public API endpoints (your CesiumJS frontend).
# Leave unset to disable CORS headers (same-origin only).
CORS_ORIGIN=http://localhost:4000

# ─── Proxy (set true if behind nginx/Caddy/etc.) ────────────────────────────
TRUST_PROXY=false
